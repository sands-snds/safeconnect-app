PORT=5000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=safeconnect
DB_PORT=3306
# Set to true for Azure Database for MySQL (it requires SSL)
DB_SSL=false

JWT_SECRET=replace_with_a_long_random_string

# Public URL of this backend, used to build full image/photo URLs
ASSET_BASE=http://localhost:5000

# Extra frontend URLs allowed to call the API (comma-separated).
# localhost:3000 is always allowed.
# e.g. ALLOWED_ORIGINS=https://<name>.azurestaticapps.net
ALLOWED_ORIGINS=
