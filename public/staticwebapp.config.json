{
  "routes": [
    {
      "route": "/admin*",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    },
    {
      "route": "/resident*",
      "headers": { "X-Robots-Tag": "noindex, nofollow" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/static/*", "*.{png,jpg,jpeg,gif,svg,ico,webp,css,js,json,txt,xml}"]
  },
  "globalHeaders": {
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
