# Frontend settings. These are baked in at build time (npm run build), so
# set them before building. Copy to .env.local for local overrides.
# Leave unset locally to use http://localhost:5000.

# e.g. https://<backend-name>.azurewebsites.net/api
REACT_APP_API_BASE=http://localhost:5000/api
# e.g. https://<backend-name>.azurewebsites.net
REACT_APP_ASSET_BASE=http://localhost:5000
